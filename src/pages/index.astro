---
import { supabase } from '../lib/supabase';

const { data: articles, error } = await supabase
  .from('articles')
  .select('*')
  .eq('status', 'published')
  .order('published_at', { ascending: false });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>AI Product Impact</title>
    <meta name="description" content="Latest AI updates summarized in structured presentation decks." />
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">AI</span>
          <span class="brand-text">
            <strong>AI Product Deck</strong>
          </span>
        </a>
      </div>
    </header>

    <main class="main-container">
      <section class="hero-strip">
        <span class="pill-badge">RELEASE NOTES</span>
        <h1>Latest AI Updates</h1>
        <p class="hero-sub">Structured single-deck summaries of key AI changes, metrics, and technical decisions.</p>
      </section>

      {error && (
        <div class="state-box">
          <p>Unable to load product updates right now.</p>
        </div>
      )}

      {!error && articles?.length === 0 && (
        <div class="state-box">
          <p>No product update decks published yet.</p>
        </div>
      )}

      <div class="deck-grid">
        {articles?.map((article) => (
          <article class="deck-card">
            <div class="card-meta">
              <span class="category">{article.category}</span>
              <span class="source">{article.source_name}</span>
            </div>

            <h2>
              <a href={`/${article.slug}`}>
                {article.content?.title ?? article.source_title}
              </a>
            </h2>

            {article.content?.problem_statement?.what_wasnt_working && (
              <p class="summary">
                {article.content.problem_statement.what_wasnt_working}
              </p>
            )}

            <div class="card-action">
              <a href={`/${article.slug}`} class="view-btn">
                Open Update Deck →
              </a>
            </div>
          </article>
        ))}
      </div>
    </main>

    <footer class="site-footer">
      <div>AI Product Updates</div>
      <span>Deck Format</span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #334155;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
    line-height: 1.5;
  }

  .site-header {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-inner {
    max-width: 1040px;
    margin: auto;
    padding: 12px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-mark {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    background: #ea580c;
    color: white;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
  }

  .brand-text strong {
    color: #0f172a;
    font-size: 15px;
  }

  .main-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 24px 20px 48px;
  }

  .hero-strip {
    text-align: center;
    padding: 16px 0 28px;
  }

  .pill-badge {
    display: inline-block;
    padding: 3px 10px;
    background: #fff7ed;
    border: 1px solid #ffedd5;
    color: #ea580c;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }

  h1 {
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: 15px;
    color: #64748b;
    margin: 0 auto;
    max-width: 580px;
  }

  .deck-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  .deck-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }

  .deck-card:hover {
    border-color: #ea580c;
    box-shadow: 0 4px 12px rgba(234, 88, 12, 0.08);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .category {
    color: #ea580c;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .source {
    font-size: 11px;
    color: #64748b;
    background: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .deck-card h2 {
    font-size: 17px;
    line-height: 1.3;
    margin: 0 0 8px;
    font-weight: 700;
  }

  .deck-card h2 a {
    text-decoration: none;
    color: #0f172a;
  }

  .deck-card h2 a:hover {
    color: #ea580c;
  }

  .summary {
    font-size: 13px;
    color: #64748b;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-action {
    padding-top: 10px;
    border-top: 1px solid #f1f5f9;
  }

  .view-btn {
    color: #ea580c;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .state-box {
    text-align: center;
    padding: 40px;
    background: #ffffff;
    border-radius: 10px;
    border: 1px dashed #cbd5e1;
    color: #64748b;
  }

  .site-footer {
    max-width: 1040px;
    margin: auto;
    padding: 16px 20px 32px;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    color: #94a3b8;
    font-size: 12px;
  }

  @media (max-width: 600px) {
    .deck-grid {
      grid-template-columns: 1fr;
    }
  }
</style>