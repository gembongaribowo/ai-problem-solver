---
import { env } from 'cloudflare:workers';
import { listPublishedArticles, type ArticleRuntimeEnv } from '../lib/articles';

const runtimeEnv = env as unknown as ArticleRuntimeEnv;
const { data: articles, error } = await listPublishedArticles(runtimeEnv);
const allArticles = articles ?? [];

const jakartaDateKey = (value) => {
  if (!value) return '';
  try {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Jakarta',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(new Date(value));
  } catch {
    return '';
  }
};

const formatDate = (value) => {
  if (!value) return '';
  try {
    return new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Jakarta',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(new Date(value));
  } catch {
    return '';
  }
};

const formatShortDate = (value) => {
  if (!value) return '';
  try {
    return new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Jakarta',
      month: 'short',
      day: 'numeric',
    }).format(new Date(value));
  } catch {
    return '';
  }
};

const now = new Date();
const todayKey = jakartaDateKey(now);
const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000);
const yesterdayKey = jakartaDateKey(yesterday);

const todayArticles = allArticles.filter((article) => jakartaDateKey(article.published_at) === todayKey);
const yesterdayArticles = allArticles.filter((article) => jakartaDateKey(article.published_at) === yesterdayKey);
const earlierArticles = allArticles.filter((article) => {
  const key = jakartaDateKey(article.published_at);
  return key !== todayKey && key !== yesterdayKey;
});

const sortByScore = (items) =>
  [...items].sort((a, b) => Number(b.score ?? 0) - Number(a.score ?? 0));

const sortedToday = sortByScore(todayArticles);
const featuredArticle = sortedToday[0] ?? null;
const todayRemaining = featuredArticle ? sortedToday.slice(1) : [];
const sortedYesterday = sortByScore(yesterdayArticles);
const sortedEarlier = sortByScore(earlierArticles);

const categories = [
  ...new Set(
    allArticles
      .map((article) => article.category)
      .filter(Boolean)
      .map((category) => String(category).trim())
  ),
].sort((a, b) => a.localeCompare(b));

const cleanTitle = (article) => {
  const raw = String(article.title ?? article.source_title ?? 'Untitled update').trim();
  const source = String(article.source_name ?? '').trim();

  if (!source) return raw;

  const escapedSource = source.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return raw.replace(new RegExp(`\\s*[|—-]\\s*${escapedSource}\\s*$`, 'i'), '').trim();
};

const getSummary = (article) => {
  if (article.summary) return String(article.summary);

  if (
    article.content &&
    typeof article.content === 'object' &&
    article.content.problem_statement?.what_wasnt_working
  ) {
    return String(article.content.problem_statement.what_wasnt_working);
  }

  return '';
};

const countToday = todayArticles.length;
const countWeek = allArticles.filter((article) => {
  if (!article.published_at) return false;
  const published = new Date(article.published_at);
  return now.getTime() - published.getTime() <= 7 * 24 * 60 * 60 * 1000;
}).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>AI Product Impact</title>
    <meta
      name="description"
      content="Practical AI product launches, adoption stories, and measurable impact — summarized for product teams."
    />
  </head>

  <body>
    <div id="reading-progress" role="progressbar" aria-label="Page scroll progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="reading-progress-bar"></span></div>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="AI Product Impact home">
          <span class="brand-mark" aria-hidden="true">AI</span>
          <span class="brand-text">AI Product Impact</span>
        </a>

        <nav class="top-nav" aria-label="Primary navigation">
          <a href="/" class="is-active">Home</a>
          <a href="#all-updates">All updates</a>
        </nav>
      </div>
    </header>

    <main class="main-container">
      <section class="hero-strip">
        <div class="hero-copy">
          <span class="pill-badge">PRODUCT INTELLIGENCE</span>
          <h1>Latest AI Product Updates</h1>
          <p class="hero-sub">
            Practical launches, adoption stories, and real-world AI impact — distilled for product teams.
          </p>

          <div class="hero-stats" aria-label="Update counts">
            <span class="hero-stat"><strong>{countToday}</strong><span>new today</span></span>
            <span class="stat-divider" aria-hidden="true"></span>
            <span class="hero-stat"><strong>{countWeek}</strong><span>this week</span></span>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <svg class="hero-illustration" viewBox="0 0 360 220" role="presentation">
            <ellipse cx="180" cy="110" rx="145" ry="45" transform="rotate(-16 180 110)" fill="none" stroke="#BDBDBD" stroke-width="1.2" />
            <ellipse cx="180" cy="110" rx="116" ry="72" transform="rotate(27 180 110)" fill="none" stroke="#D9D9D9" stroke-width="1.2" />
            <circle cx="180" cy="110" r="54" fill="none" stroke="#D9D9D9" stroke-width="1" />
            <path d="M62 139 118 123 154 132 202 88 241 98 294 67" fill="none" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="62" cy="139" r="4" fill="#000000" />
            <circle cx="118" cy="123" r="4" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
            <circle cx="241" cy="98" r="4" fill="#FFFFFF" stroke="#000000" stroke-width="1.5" />
            <circle cx="294" cy="67" r="4" fill="#000000" />
            <rect x="148" y="78" width="64" height="64" rx="8" fill="#000000" />
            <text x="180" y="120" fill="#FFFFFF" font-family="Inter,Arial,sans-serif" font-size="24" font-weight="700" text-anchor="middle" letter-spacing="-1">AI</text>
          </svg>
          <span class="hero-visual-caption">SIGNALS → IMPACT</span>
        </div>
      </section>

      {error && (
        <div class="state-box">
          <p>Unable to load product updates right now.</p>
        </div>
      )}

      {!error && allArticles.length === 0 && (
        <div class="state-box">
          <p>No product updates published yet.</p>
        </div>
      )}

      {!error && allArticles.length > 0 && (
        <>
          <section class="filter-bar" aria-label="Browse and search updates">
            <div class="filter-left">
              <div class="filter-label">Browse by category</div>
              <div class="filter-scroll">
                <button class="filter-chip is-active" type="button" data-filter="all">All</button>
                {categories.map((category) => (
                  <button class="filter-chip" type="button" data-filter={category.toLowerCase()}>
                    {category}
                  </button>
                ))}
              </div>
            </div>

            <label class="search-box">
              <span class="sr-only">Search updates</span>
              <input id="update-search" type="search" placeholder="Search updates..." autocomplete="off" />
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.6-3.6"></path>
              </svg>
            </label>
          </section>

          <section class="update-section today-section" data-section>
            <div class="section-heading">
              <div>
                <span class="section-kicker">TODAY</span>
                <h2>New today</h2>
              </div>
              <span class="section-count">{todayArticles.length} updates</span>
            </div>

            {todayArticles.length === 0 ? (
              <div class="empty-today" data-empty-state>
                <strong>No new updates yet today.</strong>
                <span>The latest published updates are still available below.</span>
              </div>
            ) : (
              <div class="today-layout">
                {featuredArticle && (
                  <article
                    class="featured-card"
                    data-card
                    data-category={String(featuredArticle.category ?? 'Other').toLowerCase()}
                    data-search={`${cleanTitle(featuredArticle)} ${featuredArticle.source_name ?? ''} ${featuredArticle.category ?? ''} ${getSummary(featuredArticle)}`.toLowerCase()}
                  >
                    <div class="featured-copy">
                      <div class="featured-topline">
                        <span class="category">{featuredArticle.category ?? 'Other'}</span>
                        <span class="source">{featuredArticle.source_name}</span>
                      </div>

                      <span class="featured-label">FEATURED UPDATE</span>
                      <h3>
                        <a href={`/${featuredArticle.slug}`}>{cleanTitle(featuredArticle)}</a>
                      </h3>

                      {getSummary(featuredArticle) && (
                        <p>{getSummary(featuredArticle)}</p>
                      )}

                      <div class="featured-footer">
                        <div class="featured-meta">
                          <span>{formatDate(featuredArticle.published_at)}</span>
                          {featuredArticle.score != null && (
                            <span>Relevance <strong>{Math.round(Number(featuredArticle.score))}</strong></span>
                          )}
                        </div>
                        <a href={`/${featuredArticle.slug}`} class="primary-btn">Read update →</a>
                      </div>
                    </div>

                    <div class="feature-art" aria-hidden="true">
                      <svg class="feature-illustration" viewBox="0 0 240 240" role="presentation">
                        <defs>
                          <pattern id="ai-dot-grid" width="12" height="12" patternUnits="userSpaceOnUse">
                            <circle cx="2" cy="2" r="1.2" fill="#333333" />
                          </pattern>
                        </defs>
                        <rect width="240" height="240" fill="#F6F6F6" />
                        <rect width="240" height="240" fill="url(#ai-dot-grid)" />
                        <rect x="64" y="64" width="112" height="112" rx="8" fill="#000000" stroke="#000000" />
                        <text x="120" y="139" fill="#FFFFFF" font-size="42" font-weight="700" font-family="Inter,Arial,sans-serif" text-anchor="middle" letter-spacing="-2">AI</text>
                      </svg>
                    </div>
                  </article>
                )}

                {todayRemaining.length > 0 && (
                  <div class="today-side-grid">
                    {todayRemaining.slice(0, 4).map((article) => (
                      <article
                        class="mini-card"
                        data-card
                        data-category={String(article.category ?? 'Other').toLowerCase()}
                        data-search={`${cleanTitle(article)} ${article.source_name ?? ''} ${article.category ?? ''} ${getSummary(article)}`.toLowerCase()}
                      >
                        <div class="mini-topline">
                          <span class="category">{article.category ?? 'Other'}</span>
                          <a href={`/${article.slug}`} aria-label={`Open ${cleanTitle(article)}`}>↗</a>
                        </div>
                        <h3><a href={`/${article.slug}`}>{cleanTitle(article)}</a></h3>
                        <span class="mini-source">{article.source_name}</span>
                        <div class="mini-footer">
                          <span>{formatShortDate(article.published_at)}</span>
                          {article.score != null && (
                            <span>Relevance <strong>{Math.round(Number(article.score))}</strong></span>
                          )}
                        </div>
                      </article>
                    ))}
                  </div>
                )}
              </div>
            )}

            {todayRemaining.length > 4 && (
              <div class="deck-grid today-more">
                {todayRemaining.slice(4).map((article) => (
                  <article
                    class="deck-card"
                    data-card
                    data-category={String(article.category ?? 'Other').toLowerCase()}
                    data-search={`${cleanTitle(article)} ${article.source_name ?? ''} ${article.category ?? ''} ${getSummary(article)}`.toLowerCase()}
                  >
                    <div>
                      <div class="card-meta">
                        <span class="category">{article.category ?? 'Other'}</span>
                        <span class="source">{article.source_name}</span>
                      </div>
                      <h3><a href={`/${article.slug}`}>{cleanTitle(article)}</a></h3>
                      {getSummary(article) && <p class="summary">{getSummary(article)}</p>}
                    </div>
                    <div class="card-footer">
                      <span>{formatShortDate(article.published_at)}</span>
                      {article.score != null && (
                        <span>Relevance <strong>{Math.round(Number(article.score))}</strong></span>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            )}
          </section>

          {sortedYesterday.length > 0 && (
            <section class="update-section" data-section>
              <div class="section-heading section-heading-inline">
                <div class="inline-date-heading">
                  <span class="section-kicker">YESTERDAY</span>
                  <span class="date-context">{formatDate(yesterday)}</span>
                </div>
                <span class="section-count">{sortedYesterday.length} updates</span>
              </div>

              <div class="deck-grid">
                {sortedYesterday.map((article) => (
                  <article
                    class="deck-card"
                    data-card
                    data-category={String(article.category ?? 'Other').toLowerCase()}
                    data-search={`${cleanTitle(article)} ${article.source_name ?? ''} ${article.category ?? ''} ${getSummary(article)}`.toLowerCase()}
                  >
                    <div>
                      <div class="card-meta">
                        <span class="category">{article.category ?? 'Other'}</span>
                        <span class="source">{article.source_name}</span>
                      </div>
                      <h3><a href={`/${article.slug}`}>{cleanTitle(article)}</a></h3>
                      <div class="card-inline-meta">
                        <span>{formatShortDate(article.published_at)}</span>
                        {article.score != null && (
                          <span>Relevance <strong>{Math.round(Number(article.score))}</strong></span>
                        )}
                      </div>
                      {getSummary(article) && <p class="summary">{getSummary(article)}</p>}
                    </div>
                    <a href={`/${article.slug}`} class="text-link">Read update →</a>
                  </article>
                ))}
              </div>
            </section>
          )}

          {sortedEarlier.length > 0 && (
            <section class="update-section" id="all-updates" data-section>
              <div class="section-heading">
                <div>
                  <span class="section-kicker">ARCHIVE</span>
                  <h2>Earlier updates</h2>
                </div>
                <span class="section-count">{sortedEarlier.length} updates</span>
              </div>

              <div class="deck-grid">
                {sortedEarlier.map((article) => (
                  <article
                    class="deck-card"
                    data-card
                    data-category={String(article.category ?? 'Other').toLowerCase()}
                    data-search={`${cleanTitle(article)} ${article.source_name ?? ''} ${article.category ?? ''} ${getSummary(article)}`.toLowerCase()}
                  >
                    <div>
                      <div class="card-meta">
                        <span class="category">{article.category ?? 'Other'}</span>
                        <span class="source">{article.source_name}</span>
                      </div>
                      <h3><a href={`/${article.slug}`}>{cleanTitle(article)}</a></h3>
                      <div class="card-inline-meta">
                        <span>{formatShortDate(article.published_at)}</span>
                        {article.score != null && (
                          <span>Relevance <strong>{Math.round(Number(article.score))}</strong></span>
                        )}
                      </div>
                      {getSummary(article) && <p class="summary">{getSummary(article)}</p>}
                    </div>
                    <a href={`/${article.slug}`} class="text-link">Read update →</a>
                  </article>
                ))}
              </div>
            </section>
          )}

          <div class="filter-empty" id="filter-empty" hidden>
            No updates match this category and search.
          </div>
        </>
      )}
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="brand brand-footer">
            <span class="brand-mark small" aria-hidden="true">AI</span>
            <span class="brand-text">AI Product Impact</span>
          </a>
          <p>Product intelligence for the AI era.<br />Practical. Impactful. Actionable.</p>
        </div>
        <div class="footer-note">Latest AI product changes, distilled for product teams.</div>
      </div>
    </footer>

    <script is:inline>
      const chips = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('[data-card]');
      const sections = document.querySelectorAll('[data-section]');
      const emptyState = document.getElementById('filter-empty');
      const searchInput = document.getElementById('update-search');

      let selectedFilter = 'all';
      let searchTerm = '';

      const refreshCards = () => {
        let visibleTotal = 0;

        cards.forEach((card) => {
          const categoryMatch = selectedFilter === 'all' || card.dataset.category === selectedFilter;
          const haystack = card.dataset.search || '';
          const searchMatch = !searchTerm || haystack.includes(searchTerm);
          const matches = categoryMatch && searchMatch;

          card.hidden = !matches;
          if (matches) visibleTotal += 1;
        });

        sections.forEach((section) => {
          const visibleCards = section.querySelectorAll('[data-card]:not([hidden])');
          const hasStaticEmptyState = section.querySelector('[data-empty-state]');

          if (selectedFilter === 'all' && !searchTerm && hasStaticEmptyState) {
            section.hidden = false;
          } else {
            section.hidden = visibleCards.length === 0;
          }
        });

        if (emptyState) emptyState.hidden = visibleTotal !== 0;
      };

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          selectedFilter = chip.dataset.filter || 'all';
          chips.forEach((item) => item.classList.remove('is-active'));
          chip.classList.add('is-active');
          refreshCards();
        });
      });

      searchInput?.addEventListener('input', (event) => {
        searchTerm = String(event.target?.value || '').trim().toLowerCase();
        refreshCards();
      });

      const revealTargets = document.querySelectorAll('.hero-strip, .filter-bar, [data-section] .section-heading, [data-card]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ('IntersectionObserver' in window && !reduceMotion) {
        document.documentElement.classList.add('scroll-reveal-ready');
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -28px 0px' });
        revealTargets.forEach((target, index) => {
          target.setAttribute('data-scroll-reveal', '');
          const delay = target.matches('[data-card]') ? Math.min((index % 4) * 55, 165) : 0;
          target.style.setProperty('--scroll-reveal-delay', delay + 'ms');
          revealObserver.observe(target);
        });
      }

      const pageProgress = document.getElementById('reading-progress');
      const pageProgressBar = document.getElementById('reading-progress-bar');
      let pageProgressFrame = 0;
      const updatePageProgress = () => {
        pageProgressFrame = 0;
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progressPercent = scrollableHeight > 0
          ? Math.min(100, Math.max(0, window.scrollY / scrollableHeight * 100))
          : 0;
        if (pageProgressBar) pageProgressBar.style.transform = 'scaleX(' + (progressPercent / 100) + ')';
        if (pageProgress) pageProgress.setAttribute('aria-valuenow', String(Math.round(progressPercent)));
      };
      window.addEventListener('scroll', () => {
        if (!pageProgressFrame) pageProgressFrame = window.requestAnimationFrame(updatePageProgress);
      }, { passive: true });
      window.addEventListener('resize', updatePageProgress);
      updatePageProgress();

      const shimmerTargets = document.querySelectorAll('.hero-visual, .filter-chip, .search-box, .featured-card, .mini-card, .deck-card, .primary-btn, .state-box, .empty-today');
      const reduceShimmer = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let shimmerTimer = 0;
      let lastPointerActivity = 0;
      const clearIdleShimmer = () => {
        window.clearTimeout(shimmerTimer);
        shimmerTargets.forEach((target) => target.classList.remove('is-idle-shimmer'));
      };
      const scheduleIdleShimmer = () => {
        clearIdleShimmer();
        if (reduceShimmer || document.hidden) return;
        shimmerTimer = window.setTimeout(() => {
          shimmerTargets.forEach((target) => {
            if (target.hidden || target.getClientRects().length === 0) return;
            target.style.setProperty('--idle-shimmer-delay', Math.round(Math.random() * 1200) + 'ms');
            target.classList.add('idle-shimmer-target', 'is-idle-shimmer');
          });
        }, 3000 + Math.round(Math.random() * 500));
      };
      ['pointerdown', 'keydown', 'scroll', 'touchstart', 'wheel'].forEach((eventName) => {
        window.addEventListener(eventName, scheduleIdleShimmer, { passive: true });
      });
      window.addEventListener('pointermove', () => {
        const now = Date.now();
        if (now - lastPointerActivity < 350) return;
        lastPointerActivity = now;
        scheduleIdleShimmer();
      }, { passive: true });
      document.addEventListener('visibilitychange', scheduleIdleShimmer);
      scheduleIdleShimmer();
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    color: #172033;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.5;
    background-color: #eef1f4;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(80, 93, 111, 0.12) 1px, transparent 1.1px),
      linear-gradient(30deg, transparent 47%, rgba(91, 103, 119, 0.05) 48%, rgba(91, 103, 119, 0.05) 49%, transparent 50%),
      linear-gradient(150deg, transparent 47%, rgba(234, 88, 12, 0.035) 48%, rgba(234, 88, 12, 0.035) 49%, transparent 50%);
    background-size: 22px 22px, 260px 150px, 260px 150px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background:
      linear-gradient(180deg, rgba(235, 239, 243, 0.98), rgba(229, 234, 239, 0.96)),
      radial-gradient(circle at 1px 1px, rgba(71, 85, 105, 0.09) 1px, transparent 1.1px);
    background-size: auto, 20px 20px;
    border-bottom: 1px solid #cbd3dc;
    backdrop-filter: blur(14px);
  }

  .header-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 13px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #101828;
    text-decoration: none;
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: #172033;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 5px 14px rgba(15, 23, 42, 0.12);
    overflow: hidden;
  }

  .brand-mark img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .brand-mark.small { width: 30px; height: 30px; border-radius: 7px; }
  .brand-text { font-size: 15px; font-weight: 800; letter-spacing: -0.015em; }

  .top-nav { display: flex; align-items: center; gap: 26px; }
  .top-nav a {
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 2px solid transparent;
  }
  .top-nav a:hover, .top-nav a.is-active { color: #ea580c; border-bottom-color: #ea580c; }

  .main-container { max-width: 1180px; margin: 0 auto; padding: 34px 22px 58px; }

  .hero-strip { text-align: center; padding: 16px 0 32px; }
  .pill-badge {
    display: inline-flex;
    padding: 5px 14px;
    color: #ea580c;
    border: 1px solid #f3a36e;
    background: rgba(255, 247, 237, 0.72);
    border-radius: 999px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
    margin-bottom: 15px;
  }

  h1 {
    margin: 0 0 10px;
    color: #101828;
    font-size: clamp(32px, 5vw, 48px);
