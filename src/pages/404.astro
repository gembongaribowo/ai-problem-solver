---
Astro.response.status = 404;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not found — AI Product Impact</title>
    <style>
      :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #111; background: #fff; }
      * { box-sizing: border-box; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; }
      main { width: min(100%, 560px); text-align: center; }
      .mark { width: 48px; height: 48px; margin: 0 auto 28px; display: grid; place-items: center; background: #000; color: #fff; border-radius: 9px; font-size: 15px; font-weight: 700; }
      .code { margin: 0 0 10px; color: #666; font-size: 13px; font-weight: 700; letter-spacing: .12em; }
      h1 { margin: 0; font-size: clamp(32px, 7vw, 48px); letter-spacing: -.04em; }
      p { margin: 16px 0 28px; color: #555; line-height: 1.7; }
      a { display: inline-flex; min-height: 46px; align-items: center; padding: 0 18px; border: 1px solid #111; border-radius: 7px; color: #fff; background: #111; text-decoration: none; font-size: 14px; font-weight: 600; }
      a:focus-visible { outline: 3px solid #888; outline-offset: 3px; }
    </style>
  </head>
  <body>
    <main>
      <div class="mark" aria-hidden="true">AI</div>
      <p class="code">ERROR 404</p>
      <h1>Page not found</h1>
      <p>The page you’re looking for may have moved or no longer exists.</p>
      <a href="/">Back to AI Product Impact</a>
    </main>
  </body>
</html>
